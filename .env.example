# Reference only: this file is NOT automatically loaded.
PUBLIC_DEPLOYMENT=true
# Public mode always enforces headless, even if this is false.
BROWSER_HEADLESS=true
VBEE_CTA_ENABLED=true
SHOPEE_AFFILIATE_URL=
# Community Cloud: auto-detects chromium installed by packages.txt.
# Docker: leave empty to use Playwright's bundled browser.
CHROMIUM_EXECUTABLE_PATH=
